## 結論
* CNN在MNIST手寫辨識上表現良好，得益於卷積層能有效擷取局部空間特徵、MaxPooling縮小尺寸並增加平移不變性
* 用**im2col**取代naive三層迴圈卷積，能大幅降低純NumPy版本的訓練時間
* Confusion Matrix比單純的accuracy更能診斷模型弱點，例如特定數字之間（如 4 與 9、2 與 7）的系統性混淆
* 若要更高準確率，可增加訓練epoch、加深網路、或加入正則化（Dropout、L2）

## 程式碼
```python=
"""
CNN From Scratch
架構: 28x28x1 -> 6x24x24 -> 6x12x12 -> 12x8x8 -> 12x4x4 -> 192 -> 10

Conv1 -> ReLU -> MaxPool -> Conv2 -> ReLU -> MaxPool -> Flatten -> FC -> Softmax+CrossEntropy

"""

import time
import numpy as np
import matplotlib.pyplot as plt

# 工具函式：im2col / col2im
def get_im2col_indices(x_shape, field_h, field_w, stride=1):
    N, C, H, W = x_shape
    out_h = (H - field_h) // stride + 1
    out_w = (W - field_w) // stride + 1

    i0 = np.repeat(np.arange(field_h), field_w)
    i0 = np.tile(i0, C)
    i1 = stride * np.repeat(np.arange(out_h), out_w)
    j0 = np.tile(np.arange(field_w), field_h * C)
    j1 = stride * np.tile(np.arange(out_w), out_h)
    i = i0.reshape(-1, 1) + i1.reshape(1, -1)
    j = j0.reshape(-1, 1) + j1.reshape(1, -1)

    k = np.repeat(np.arange(C), field_h * field_w).reshape(-1, 1)
    return k, i, j


def im2col(x, field_h, field_w, stride=1):
    """[N,C,H,W] -> [C*field_h*field_w, N*out_h*out_w]"""
    N, C, H, W = x.shape
    k, i, j = get_im2col_indices(x.shape, field_h, field_w, stride)
    cols = x[:, k, i, j]  # [N, C*fh*fw, out_h*out_w]
    cols = cols.transpose(1, 2, 0).reshape(C * field_h * field_w, -1)
    return cols


def col2im(cols, x_shape, field_h, field_w, stride=1):
    """cols -> [N,C,H,W]，用於 backward 把 gradient 疊加回原本 patch 的位置"""
    N, C, H, W = x_shape
    out_h = (H - field_h) // stride + 1
    out_w = (W - field_w) // stride + 1
    k, i, j = get_im2col_indices(x_shape, field_h, field_w, stride)

    cols_reshaped = cols.reshape(C * field_h * field_w, out_h * out_w, N).transpose(2, 0, 1)
    x = np.zeros((N, C, H, W), dtype=cols.dtype)
    np.add.at(x, (slice(None), k, i, j), cols_reshaped)
    return x

# Layer 1: Conv2D
class Conv2D:
    def __init__(self, in_channels, out_channels, kernel_size, stride=1):
        self.in_channels = in_channels
        self.out_channels = out_channels
        self.k = kernel_size
        self.stride = stride

        # He initialization
        scale = np.sqrt(2.0 / (in_channels * kernel_size * kernel_size))
        self.W = np.random.randn(out_channels, in_channels, kernel_size, kernel_size) * scale
        self.b = np.zeros(out_channels)

        self.dW = None
        self.db = None
        self._cache = None

    def forward(self, x):
        # x: [N, C, H, W]
        N, C, H, W = x.shape
        out_h = (H - self.k) // self.stride + 1
        out_w = (W - self.k) // self.stride + 1

        x_cols = im2col(x, self.k, self.k, self.stride)          # [C*k*k, N*out_h*out_w]
        W_row = self.W.reshape(self.out_channels, -1)            # [out_c, C*k*k]

        out = W_row @ x_cols + self.b.reshape(-1, 1)             # [out_c, N*out_h*out_w]
        out = out.reshape(self.out_channels, out_h, out_w, N).transpose(3, 0, 1, 2)  # [N,out_c,out_h,out_w]

        self._cache = (x, x_cols)
        return out

    def backward(self, dout):
        x, x_cols = self._cache
        N, C, H, W = x.shape

        # dout: [N, out_c, out_h, out_w] -> [out_c, N*out_h*out_w]
        dout_reshaped = dout.transpose(1, 2, 3, 0).reshape(self.out_channels, -1)

        self.db = dout_reshaped.sum(axis=1)
        self.dW = (dout_reshaped @ x_cols.T).reshape(self.W.shape)

        W_row = self.W.reshape(self.out_channels, -1)
        dx_cols = W_row.T @ dout_reshaped                        # [C*k*k, N*out_h*out_w]
        dx = col2im(dx_cols, x.shape, self.k, self.k, self.stride)
        return dx

# Layer 2: ReLU
class ReLU:
    def __init__(self):
        self._mask = None

    def forward(self, x):
        self._mask = x > 0
        return x * self._mask

    def backward(self, dout):
        return dout * self._mask

# Layer 3: MaxPool2D
class MaxPool2D:
    def __init__(self, size=2, stride=2):
        self.size = size
        self.stride = stride
        self._cache = None

    def forward(self, x):
        N, C, H, W = x.shape
        s, st = self.size, self.stride
        out_h = (H - s) // st + 1
        out_w = (W - s) // st + 1

        out = np.zeros((N, C, out_h, out_w))
        # 記住每個 pooling window 裡最大值的位置，backward 才知道 gradient 要傳去哪
        argmax = np.zeros((N, C, out_h, out_w, 2), dtype=int)

        for i in range(out_h):
            for j in range(out_w):
                h_start, w_start = i * st, j * st
                window = x[:, :, h_start:h_start + s, w_start:w_start + s]  # [N,C,s,s]
                window_flat = window.reshape(N, C, -1)
                idx = np.argmax(window_flat, axis=2)
                out[:, :, i, j] = np.max(window_flat, axis=2)
                argmax[:, :, i, j, 0] = idx // s
                argmax[:, :, i, j, 1] = idx % s

        self._cache = (x.shape, argmax)
        return out

    def backward(self, dout):
        x_shape, argmax = self._cache
        N, C, H, W = x_shape
        s, st = self.size, self.stride
        out_h, out_w = dout.shape[2], dout.shape[3]

        dx = np.zeros(x_shape)
        for i in range(out_h):
            for j in range(out_w):
                h_start, w_start = i * st, j * st
                for n in range(N):
                    for c in range(C):
                        dh, dw = argmax[n, c, i, j]
                        dx[n, c, h_start + dh, w_start + dw] += dout[n, c, i, j]
        return dx

# Layer 4: Flatten
class Flatten:
    def __init__(self):
        self._shape = None

    def forward(self, x):
        self._shape = x.shape
        return x.reshape(x.shape[0], -1)  # batch dimension 保留 (Section 16)

    def backward(self, dout):
        return dout.reshape(self._shape)

# Layer 5: Fully Connected (Linear)
class Linear:
    def __init__(self, in_features, out_features):
        scale = np.sqrt(2.0 / in_features)
        self.W = np.random.randn(in_features, out_features) * scale
        self.b = np.zeros(out_features)
        self.dW = None
        self.db = None
        self._x = None

    def forward(self, x):
        self._x = x
        return x @ self.W + self.b

    def backward(self, dout):
        self.dW = self._x.T @ dout
        self.db = dout.sum(axis=0)
        dx = dout @ self.W.T
        return dx

# 整個 CNN：串起所有 layer 
class SimpleCNN:
    def __init__(self):
        self.conv1 = Conv2D(in_channels=1, out_channels=6, kernel_size=5)
        self.relu1 = ReLU()
        self.pool1 = MaxPool2D(size=2, stride=2)

        self.conv2 = Conv2D(in_channels=6, out_channels=12, kernel_size=5)
        self.relu2 = ReLU()
        self.pool2 = MaxPool2D(size=2, stride=2)

        self.flatten = Flatten()
        self.fc = Linear(12 * 4 * 4, 10)

        self.loss_fn = SoftmaxCrossEntropy()

    def forward(self, x):
        x = self.conv1.forward(x)      # [N,6,24,24]
        x = self.relu1.forward(x)
        x = self.pool1.forward(x)      # [N,6,12,12]

        x = self.conv2.forward(x)      # [N,12,8,8]
        x = self.relu2.forward(x)
        x = self.pool2.forward(x)      # [N,12,4,4]

        x = self.flatten.forward(x)    # [N,192]
        logits = self.fc.forward(x)    # [N,10]
        return logits

    def compute_loss(self, logits, labels):
        return self.loss_fn.forward(logits, labels)

    def backward(self):
        dlogits = self.loss_fn.backward()          # [N,10]
        dx = self.fc.backward(dlogits)              # [N,192]
        dx = self.flatten.backward(dx)               # [N,12,4,4]

        dx = self.pool2.backward(dx)                 # [N,12,8,8]
        dx = self.relu2.backward(dx)
        dx = self.conv2.backward(dx)                  # [N,6,12,12]

        dx = self.pool1.backward(dx)                  # [N,6,24,24]
        dx = self.relu1.backward(dx)
        dx = self.conv1.backward(dx)                   # [N,1,28,28]
        return dx

    def parameters_and_grads(self):
        """回傳所有需要更新的 (parameter, gradient) pair，給 optimizer 用"""
        return [
            (self.conv1.W, self.conv1.dW), (self.conv1.b, self.conv1.db),
            (self.conv2.W, self.conv2.dW), (self.conv2.b, self.conv2.db),
            (self.fc.W, self.fc.dW), (self.fc.b, self.fc.db),
        ]

def load_mnist(train_ratio=2000, test_ratio=200, valid_ratio=100, seed=42):
    #回傳的 X 形狀是 [N,1,28,28]
    assert abs(train_ratio + test_ratio + valid_ratio - 1.0) < 1e-6, \
        "train_ratio + test_ratio + valid_ratio 必須等於 1"

    from sklearn.datasets import fetch_openml
    mnist = fetch_openml("mnist_784", version=1, as_frame=False)
    X = mnist.data.astype(np.float32) / 255.0
    y = mnist.target.astype(np.int64)
    X = X.reshape(-1, 1, 28, 28)

    # 先打亂再切，避免 MNIST 原本照數字排序導致每個 split 類別分布不均
    N = X.shape[0]
    rng = np.random.default_rng(seed)
    indices = rng.permutation(N)
    X, y = X[indices], y[indices]

    n_train = int(N * train_ratio)
    n_test = int(N * test_ratio)

    X_train, y_train = X[:n_train], y[:n_train]
    X_test, y_test = X[n_train:n_train + n_test], y[n_train:n_train + n_test]
    X_valid, y_valid = X[n_train + n_test:], y[n_train + n_test:]

    return X_train, y_train, X_test, y_test, X_valid, y_valid


def iterate_minibatches(X, y, batch_size, shuffle=True, seed=None):
    N = X.shape[0]
    indices = np.arange(N)
    if shuffle:
        rng = np.random.default_rng(seed)
        rng.shuffle(indices)
    for start in range(0, N, batch_size):
        batch_idx = indices[start:start + batch_size]
        yield X[batch_idx], y[batch_idx]


def accuracy(logits, labels):
    preds = np.argmax(logits, axis=1)
    return np.mean(preds == labels)

class SoftmaxCrossEntropy:
    def __init__(self):
        self._probs = None
        self._labels = None

    def forward(self, logits, labels):
        shifted = logits - np.max(logits, axis=1, keepdims=True)
        exp = np.exp(shifted)
        probs = exp / np.sum(exp, axis=1, keepdims=True)

        N = logits.shape[0]
        log_likelihood = -np.log(probs[np.arange(N), labels] + 1e-12)
        loss = np.mean(log_likelihood)

        self._probs = probs
        self._labels = labels
        return loss

    def backward(self):
        N = self._probs.shape[0]
        dlogits = self._probs.copy()
        dlogits[np.arange(N), self._labels] -= 1
        dlogits /= N
        return dlogits

class AdamOptimizer:
    def __init__(self, params, lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8):
        """
        params: list of (param_array, grad_array) tuples，例如 model.parameters_and_grads()
                只在建構時用來決定每個參數的 shape，之後 step() 要重新傳一份最新的 params 進來
                （因為每次 backward 後 grad_array 都是新的物件）
        """
        self.lr = lr
        self.beta1 = beta1
        self.beta2 = beta2
        self.eps = eps
        self.t = 0
        self.m = [np.zeros_like(p) for p, g in params]
        self.v = [np.zeros_like(p) for p, g in params]

    def step(self, params):
        """params: list of (param_array, grad_array)，跟建構時的順序、shape 必須一致"""
        self.t += 1
        for i, (p, g) in enumerate(params):
            self.m[i] = self.beta1 * self.m[i] + (1 - self.beta1) * g
            self.v[i] = self.beta2 * self.v[i] + (1 - self.beta2) * (g ** 2)

            # bias correction：訓練初期 m, v 會偏向 0，這裡做修正
            m_hat = self.m[i] / (1 - self.beta1 ** self.t)
            v_hat = self.v[i] / (1 - self.beta2 ** self.t)

            p -= self.lr * m_hat / (np.sqrt(v_hat) + self.eps)  # in-place 更新，直接改到原本的權重

# 驗證/觀察工具 3: Confusion Matrix
def compute_confusion_matrix(y_true, y_pred, num_classes=10):
    cm = np.zeros((num_classes, num_classes), dtype=int)
    for t, p in zip(y_true, y_pred):
        cm[t, p] += 1
    return cm


def plot_confusion_matrix(y_true, y_pred, num_classes=10, title="Confusion Matrix",
                        save_path="confusion_matrix.png"):
    cm = compute_confusion_matrix(y_true, y_pred, num_classes)

    fig, ax = plt.subplots(figsize=(6, 6))
    im = ax.imshow(cm, cmap="Blues")
    ax.set_xticks(range(num_classes))
    ax.set_yticks(range(num_classes))
    ax.set_xlabel("Predicted label")
    ax.set_ylabel("True label")
    ax.set_title(title)

    threshold = cm.max() / 2 if cm.max() > 0 else 0
    for i in range(num_classes):
        for j in range(num_classes):
            ax.text(j, i, cm[i, j], ha="center", va="center", fontsize=8,
                    color="white" if cm[i, j] > threshold else "black")

    plt.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    plt.tight_layout()
    plt.savefig(save_path, dpi=150)
    plt.show()
    return cm

def plot_loss_curve(batch_losses, epoch_losses, title_prefix=""):
    fig, axes = plt.subplots(1, 2, figsize=(12, 4))

    axes[0].plot(batch_losses, linewidth=0.8)
    axes[0].set_title(f"{title_prefix} Loss per Batch")
    axes[0].set_xlabel("Batch (across all epochs)")
    axes[0].set_ylabel("Loss")
    axes[0].grid(alpha=0.3)

    axes[1].plot(range(1, len(epoch_losses) + 1), epoch_losses, marker="o")
    axes[1].set_title(f"{title_prefix} Loss per Epoch (average)")
    axes[1].set_xlabel("Epoch")
    axes[1].set_ylabel("Loss")
    axes[1].grid(alpha=0.3)

    plt.tight_layout()
    plt.show()

def show_misclassified(preds, X_images, y_true, num_show=16, save_path="misclassified.png"):
    wrong_idx = np.where(preds != y_true)[0]
    print(f"測試集共 {len(y_true)} 筆，預測錯誤 {len(wrong_idx)} 筆 "
        f"(錯誤率 {len(wrong_idx) / len(y_true):.2%})")

    if len(wrong_idx) == 0:
        print("沒有預測錯誤的圖片可以顯示。")
        return

    show_idx = wrong_idx[:num_show]
    n = len(show_idx)
    cols = 4
    rows = int(np.ceil(n / cols))

    fig, axes = plt.subplots(rows, cols, figsize=(cols * 2, rows * 2.2))
    axes = np.array(axes).reshape(-1)

    for ax, idx in zip(axes, show_idx):
        ax.imshow(X_images[idx], cmap="gray")
        ax.set_title(f"true={y_true[idx]} pred={preds[idx]}", fontsize=9)
        ax.axis("off")

    for ax in axes[n:]:
        ax.axis("off")

    plt.tight_layout()
    plt.show()

# Main: 完整 training loop
def main():
    np.random.seed(42)

    batch_size = 32
    num_epochs = 3
    lr = 0.001  # Adam 的常見預設學習率比 SGD 小很多，因為它會自動調整每個參數的步伐

    print("載入 MNIST 資料")
    X_train, y_train, X_test, y_test, X_valid, y_valid = load_mnist(
        train_ratio=0.7, test_ratio=0.2, valid_ratio=0.1
    )
    print(f"train: {X_train.shape}, test: {X_test.shape}, valid: {X_valid.shape}")

    model = SimpleCNN()
    optimizer = AdamOptimizer(model.parameters_and_grads(), lr=lr)

    batch_losses = []   # 每個 batch 的 loss，畫出來看細節震盪
    epoch_losses = []   # 每個 epoch 的平均 loss，畫出來看整體收斂趨勢
    epoch_times = []    # 每個 epoch 花的時間 (秒)

    train_start = time.time()

    for epoch in range(1, num_epochs + 1):
        epoch_start = time.time()
        total_loss, total_correct, total_count = 0.0, 0, 0

        for X_batch, y_batch in iterate_minibatches(X_train, y_train, batch_size):
            # Forward
            logits = model.forward(X_batch)
            loss = model.compute_loss(logits, y_batch)

            # Backward 
            model.backward()

            # Update (Adam)
            optimizer.step(model.parameters_and_grads())

            batch_losses.append(loss)

            total_loss += loss * X_batch.shape[0]
            total_correct += np.sum(np.argmax(logits, axis=1) == y_batch)
            total_count += X_batch.shape[0]

        epoch_time = time.time() - epoch_start
        epoch_times.append(epoch_time)

        train_loss = total_loss / total_count
        train_acc = total_correct / total_count
        epoch_losses.append(train_loss)

        # 每個 epoch 用 validation set 監控訓練狀況（不參與訓練，只看 forward）
        valid_logits = model.forward(X_valid)
        valid_acc = accuracy(valid_logits, y_valid)

        print(f"Epoch {epoch}/{num_epochs} | train_loss={train_loss:.4f} "
            f"train_acc={train_acc:.4f} | valid_acc={valid_acc:.4f} | "
            f"time={epoch_time:.2f}s")

    total_train_time = time.time() - train_start
    print(f"\n總訓練時間 = {total_train_time:.2f}s "
        f"(平均每個 epoch = {np.mean(epoch_times):.2f}s)")

    # 訓練全部結束後，才用 test set 做最終、只評估一次的成績
    test_logits = model.forward(X_test)
    test_acc = accuracy(test_logits, y_test)
    print(f"最終 test_acc = {test_acc:.4f}")

    #1. Loss 曲線：觀察收斂情況
    plot_loss_curve(batch_losses, epoch_losses, title_prefix="CNN")

    #2. 把預測錯的圖片畫出來
    test_preds = np.argmax(test_logits, axis=1)
    show_misclassified(test_preds, X_test[:, 0], y_test, num_show=16,
                        save_path="cnn_misclassified.png")

    #3. Confusion Matrix 
    plot_confusion_matrix(y_test, test_preds, num_classes=10,
                        title="CNN Confusion Matrix",
                        save_path="cnn_confusion_matrix.png")

    return {
        "model": model,
        "test_acc": test_acc,
        "batch_losses": batch_losses,
        "epoch_losses": epoch_losses,
        "total_train_time": total_train_time,
        "epoch_times": epoch_times,
    }


if __name__ == "__main__":
    main()
